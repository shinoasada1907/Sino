# Template for the local environment. Copy to .env and fill in real values.
# This file is read by Docker Compose (compose.yaml) and, from BE-02, by the
# `local` Spring profile (spring.config.import: optional:file:.env[.properties]).
# Format rules (both readers must understand it): KEY=value, no quotes,
# no `export`, no spaces around `=`, avoid `$` and `\` in values.

# PostgreSQL container (BE-01)
POSTGRES_DB=sino
POSTGRES_USER=sino
POSTGRES_PASSWORD=change-me

# REST API user, HTTP Basic (BE-04, D-02 A)
SINO_API_USERNAME=sino
SINO_API_PASSWORD=change-me

# Owner, the single Sino user of the MVP (BE-09, D-10). The email is the key:
# changing it creates a new owner, changing the display name updates it.
SINO_OWNER_EMAIL=me@example.com
SINO_OWNER_DISPLAY_NAME=Sino Owner
# Browser sign-in (D-22, D-33): the owner signs in with SINO_OWNER_EMAIL and this
# password, at least 12 characters. The app keeps only a BCrypt hash of it.
SINO_OWNER_PASSWORD=
# Signs the "keep me signed in" cookie (D-34), at least 32 characters.
# Generate it with `openssl rand -base64 32`. Changing it signs every browser out.
SINO_REMEMBER_ME_KEY=

# Credential encryption key (BE-12, D-11): base64 of 32 random bytes.
# Generate your own with `openssl rand -base64 32` and keep a copy outside the repo:
# losing it means every connected account must be connected again.
SINO_CREDENTIAL_ACTIVE_KEY_ID=k1
SINO_CREDENTIAL_KEY_K1=
