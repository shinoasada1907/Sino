# Template for the local environment. Copy to .env and fill in real values.
# This file is read by Docker Compose (compose.yaml) and, from BE-02, by the
# `local` Spring profile (spring.config.import: optional:file:.env[.properties]).
# Format rules (both readers must understand it): KEY=value, no quotes,
# no `export`, no spaces around `=`, avoid `$` and `\` in values.

# PostgreSQL container (BE-01)
POSTGRES_DB=sino
POSTGRES_USER=sino
POSTGRES_PASSWORD=change-me

# Owner, the single Sino user of the MVP (BE-09, D-10). The email is the key:
# changing it creates a new owner, changing the display name updates it.
SINO_OWNER_EMAIL=me@example.com
SINO_OWNER_DISPLAY_NAME=Sino Owner
# Browser sign-in (D-22, D-33): the owner signs in with SINO_OWNER_EMAIL and this
# password, at least 12 characters. The app keeps only a BCrypt hash of it.
SINO_OWNER_PASSWORD=
# Signs the "keep me signed in" cookie (D-34), at least 32 characters.
# Generate it with `openssl rand -base64 32`. Changing it signs every browser out.
SINO_REMEMBER_ME_KEY=
# Optional admin (D-260, D-261): a person who runs Sino, signs in like the owner and
# reaches /api/admin/** only, never the owner's mail. Leave the email empty for no admin.
# With an email: password of at least 12 characters, email different from the owner's.
SINO_ADMIN_EMAIL=
SINO_ADMIN_PASSWORD=
# Set to true when the app runs behind HTTPS, so the session cookie is sent over HTTPS only.
SINO_SESSION_COOKIE_SECURE=false

# Credential encryption key (BE-12, D-11): base64 of 32 random bytes.
# Generate your own with `openssl rand -base64 32` and keep a copy outside the repo:
# losing it means every connected account must be connected again.
SINO_CREDENTIAL_ACTIVE_KEY_ID=k1
SINO_CREDENTIAL_KEY_K1=

# Google OAuth client for connecting Gmail accounts (F04a, D-38). Create it in the
# Google Cloud console (APIs & Services > Credentials > OAuth client ID, type
# "Web application"). Leave both empty to turn Gmail off; setting only one stops the app.
# How to create the Google project and the client: README, section "Gmail: Google project".
SINO_GOOGLE_CLIENT_ID=
SINO_GOOGLE_CLIENT_SECRET=
# Gmail tells Sino of new mail through Google Cloud Pub/Sub (F07, D-76), in the same
# Google project: the topic Gmail publishes to (projects/<project id>/topics/<topic name>),
# and for the push subscription that delivers to <public address>/api/webhooks/gmail the
# audience it was given and the email of its service account. Set all three, or leave all
# three empty to only poll Gmail for new mail (every minute); half of them stops the app.
SINO_GOOGLE_PUBSUB_TOPIC=
SINO_GOOGLE_PUBSUB_AUDIENCE=
SINO_GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# The address the browser uses to reach Sino. With Gmail on, Google sends the browser
# back to <this>/api/accounts/connect/gmail/callback, which must be listed as a redirect
# URI of the OAuth client. http://localhost:5173 is the Vite dev server (D-36).
SINO_PUBLIC_BASE_URL=http://localhost:5173

# Personal Zalo through the sino-zalo service (F09, apps/sino-zalo). Off unless true.
# On, SINO_ZALO_SECRET is required: the same value as SINO_ZALO_SECRET in
# apps/sino-zalo/.env, at least 32 bytes. Generate it with
# `node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"`.
# SINO_ZALO_URL is where sino-zalo listens, on this machine (D-282).
SINO_ZALO_ENABLED=false
SINO_ZALO_URL=http://127.0.0.1:8090
SINO_ZALO_SECRET=
