# Shared secret between sino-api and sino-zalo: at least 32 bytes, the same value on both sides.
# Generate one: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SINO_ZALO_SECRET=
# Listen on this machine only (D-282).
SINO_ZALO_HOST=127.0.0.1
SINO_ZALO_PORT=8090
# Where sino-api listens: sino-zalo calls its webhook when a session ends (D-277).
SINO_API_URL=http://127.0.0.1:8080